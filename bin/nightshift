#!/bin/sh
# CLI de nightshift. A diferencia de ns-hook, este sí propaga el exit code:
# `nightshift doctor` y `nightshift selftest` son gates.
ROOT="${CLAUDE_PLUGIN_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
  exec "${NIGHTSHIFT_PYTHON:-python3}" -m nightshift "$@"
